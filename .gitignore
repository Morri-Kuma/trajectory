# Python/cache artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editor and local metadata
.idea/
.vscode/
benchmark/methods/**/.git/

# Logs and scheduler output
logs/
*.log
*.out
*.err

# Local render/check artifacts
docx_render_check/
project_tree.txt
_sctimebench_text.txt

# Large scientific data and model artifacts
data/
models/
*.h5ad
*.h5
*.loom
*.mtx
*.npy
*.npz
*.pkl
*.pth
*.pt

# Benchmark-heavy intermediates. Keep lightweight metrics/reports trackable.
