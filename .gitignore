benchmark/methods/MIOFlow/tutorials/
benchmark/methods/MIOFlow/docs/
benchmark/methods/MIOFlow/data/
benchmark/methods/MIOFlow/.github/
benchmark/methods/MIOFlow/.gitignore
benchmark/methods/MIOFlow/uv.lock
benchmark/methods/MIOFlow/CLAUDE.md
benchmark/methods/MIOFlow/mkdocs.yml
benchmark/methods/MIOFlow/Makefile
benchmark/methods/MIOFlow/.python-version

# Vendored method extras copied from upstream repositories.
benchmark/methods/PRESCIENT/prescient_module/
benchmark/methods/scNODE/scNODE_module/baseline/prescient_model/prescient/
benchmark/methods/scNODE/scNODE_module/model_illustration.jpg
benchmark/methods/scNODE/scNODE_module/model_validation/
benchmark/methods/scNODE/scNODE_module/optim/
benchmark/methods/scNODE/scNODE_module/plotting/

# ── Release hygiene: large REGENERABLE derived-data artifacts ──────────────────
# These are produced by the pipeline / providers and are reconstructable from the
# documented recipes; keeping them out of git keeps the release lightweight.
# (Small traceable artifacts — metrics JSON/CSV, *_ci.csv, manifests, reference
#  graphs, *_metadata.json — are intentionally NOT matched here.)
**/annotation_votes.tsv
**/state_labels.tsv
**/trajectory_aware_annotation_qc.csv
**/projected_milestone_labels.csv
**/disagreement_cells.csv
**/ood_scanvi_latent.csv
**/*_author_cluster_matched_cells.tsv
benchmark/reports/**/pca_annotation_comparison/*.png
**/[TEMP]*.ipynb

# Literature PDFs (not code; archive separately, e.g. Zenodo)
reference/**/*.pdf
