benchmark/results/**/*.h5
benchmark/results/**/*.npy
benchmark/results/**/*.npz
benchmark/results/**/*.pth
benchmark/results/**/*.pt

# Annotation module verification scratch outputs
benchmark/tmp_annotation_step*/

# OS files
.DS_Store
Thumbs.db

# Vendored method extras that are not needed for benchmark execution
